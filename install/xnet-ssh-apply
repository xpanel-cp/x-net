#!/usr/bin/env bash
# ============================================================
#  xnet-ssh-apply — applies the panel's SSH subsystem settings to the real
#  system services (Dropbear, stunnel/TLS, SlowDNS, BadVPN/UDPGW, WebSocket,
#  and per-instance sshd config files) and (re)starts/stops each unit to match.
#
#  The panel (running as the unprivileged "xnet" user) writes its settings to
#  the JSON file and invokes this script via:
#     sudo -n /opt/xnet/xnet-ssh-apply <settings-json-path>
#
#  CRITICAL: This script NEVER modifies AllowGroups in any sshd config file.
#  Only the Port directive is updated — protocol group isolation is preserved.
#
#  Exit codes: 0 = success, 1 = usage/input error, 2 = partial apply error
# ============================================================
# XNET_SSH_APPLY_VERSION=9   (v9: the per-account stats block moves into the SSH banner itself — per-account banner files selected by `Match User`, because session-channel output never reaches SSH-tunnel clients)
# XNET_SSH_APPLY_VERSION=8   (v8: apply the panel's banner setting — write /etc/ssh/xnet-banner.txt + set Banner directive in all sshd configs + Dropbear -b flag; also install per-user info profile.d script)
set -uo pipefail

SETTINGS_FILE="${1:-/opt/xnet/ssh-settings.json}"

log() { echo "[xnet-ssh-apply] $*"; }

[ -f "$SETTINGS_FILE" ] || { log "settings file not found: $SETTINGS_FILE"; exit 1; }

# --- JSON readers ------------------------------------------------------------
have_jq=0
command -v jq >/dev/null 2>&1 && have_jq=1

jget() {
  local path="$1" def="${2:-}"
  local val=""
  if [ "$have_jq" = "1" ]; then
    val="$(jq -r "$path // empty" "$SETTINGS_FILE" 2>/dev/null)"
  else
    val="$(python3 - "$SETTINGS_FILE" "$path" <<'PY' 2>/dev/null
import json,sys
data=json.load(open(sys.argv[1]))
path=sys.argv[2].lstrip('.').split('.')
cur=data
for k in path:
    if isinstance(cur,dict) and k in cur:
        cur=cur[k]
    else:
        cur=""
        break
print("" if cur is None else cur)
PY
)"
  fi
  [ -z "$val" ] && val="$def"
  echo "$val"
}

HAD_ERROR=0

# unit_exists returns 0 if a systemd unit is installed on this host (either as a
# unit file or a loaded/generated unit), 1 otherwise. Used to avoid treating an
# optional, not-installed unit (e.g. a WS sshd that is panel-managed in-process)
# as a hard apply failure.
unit_exists() {
  local unit="$1"
  # Normalize: allow callers to pass "name" or "name.service".
  case "$unit" in
    *.*) : ;;
    *)   unit="${unit}.service" ;;
  esac
  systemctl list-unit-files "$unit" >/dev/null 2>&1 \
    && systemctl list-unit-files "$unit" 2>/dev/null | grep -q "$unit" && return 0
  systemctl cat "$unit" >/dev/null 2>&1
}

restart_unit() {
  local unit="$1"
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable "$unit" >/dev/null 2>&1 || true
  if ! systemctl restart "$unit" >/dev/null 2>&1; then
    systemctl start "$unit" >/dev/null 2>&1 || { log "warning: failed to start $unit"; HAD_ERROR=1; }
  fi
}

# restart_first_existing restarts the first installed unit from the given list.
# If none of the candidate units exist, it does NOT flag HAD_ERROR — the caller
# treats a missing optional unit as "nothing to do" (returns non-zero so callers
# can branch). Returns 0 if a unit was found and a restart attempted.
restart_first_existing() {
  local u
  for u in "$@"; do
    if unit_exists "$u"; then
      restart_unit "$u"
      return 0
    fi
  done
  return 1
}

stop_unit() {
  local unit="$1"
  systemctl stop "$unit" >/dev/null 2>&1 || true
  systemctl disable "$unit" >/dev/null 2>&1 || true
  case "$unit" in
    slowdns)      pkill -f dns-server >/dev/null 2>&1 || true ;;
    badvpn-udpgw) pkill -f badvpn-udpgw >/dev/null 2>&1 || true ;;
  esac
}

# open_fw_port opens a TCP port in whichever firewall is active (ufw or
# firewalld). Best-effort and idempotent; does nothing if no managed firewall is
# running. Used so a port change from the panel never silently locks out access.
open_fw_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 0
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow "${p}/tcp" >/dev/null 2>&1 || true
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --reload >/dev/null 2>&1 || true
  fi
}

# ensure_login_group_membership is an ANTI-LOCKOUT safety net. The main sshd is
# protected by `AllowGroups ssh-tcp-users` (added by xnet-install-sshd.sh). When
# the panel changes the OpenSSH port we restart sshd, which makes that directive
# take effect. If the administrative login user is NOT in the allowed group, the
# restart would lock them out. So, whenever sshd_config carries an AllowGroups
# line that includes ssh-tcp-users, guarantee that root (the universal fallback
# admin) — and the panel's configured SSH admin, if any — belong to that group.
# This NEVER edits the AllowGroups directive itself (only group membership), so
# protocol isolation is preserved.
ensure_login_group_membership() {
  local cfg=/etc/ssh/sshd_config
  [ -f "$cfg" ] || return 0
  # Only act when the main sshd actually restricts logins by group.
  grep -qiE '^[[:space:]]*AllowGroups[[:space:]].*\bssh-tcp-users\b' "$cfg" || return 0

  command -v groupadd >/dev/null 2>&1 && groupadd -f ssh-tcp-users >/dev/null 2>&1 || true

  local u
  for u in root "${XNET_SSH_ADMIN_USER:-}"; do
    [ -n "$u" ] || continue
    id "$u" >/dev/null 2>&1 || continue
    if ! id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx ssh-tcp-users; then
      usermod -aG ssh-tcp-users "$u" >/dev/null 2>&1 \
        && log "anti-lockout: added '$u' to ssh-tcp-users (AllowGroups is active)" \
        || log "warning: could not add '$u' to ssh-tcp-users"
    fi
  done
}

# harden_tunnel_accounts stops panel SSH accounts from getting an interactive
# shell on the MAIN sshd (the SSH TCP port).
#
# The secondary instances (WS / TLS / SlowDNS) have always carried
# `ForceCommand /bin/cat`, so those ports were already shell-free. The main
# sshd had no such directive, which is how a tunnel account could `ssh` in and
# land on a real prompt on the box.
#
# WHY A Match BLOCK AND NOT A GLOBAL DIRECTIVE: a global ForceCommand in
# /etc/ssh/sshd_config applies to EVERY account including root, which would take
# away the operator's own shell on the next restart — a lockout, delivered by a
# hardening step. So the directive is confined to a Match block.
#
# WHY THE EXCLUSIONS: `Match Group ssh-tcp-users` alone is not safe either,
# because ensure_login_group_membership deliberately ADDS root and the panel's
# configured SSH admin to that very group (that is the anti-lockout for
# AllowGroups). Matching the group without excluding them would hit exactly the
# two accounts that must keep a shell. Match criteria are ANDed, so adding
# `User *,!root,!<admin>` narrows it to the panel's tunnel accounts.
#
# /bin/cat holds the session channel open without running anything, so a client
# that requests a shell is not disconnected. Port forwarding is untouched: a
# forced command replaces the SESSION channel only, never direct-tcpip, which
# stays governed by AllowTcpForwarding.
harden_tunnel_accounts() {
  local cfg=/etc/ssh/sshd_config
  [ -f "$cfg" ] || return 0

  local marker="# >>> xnet tunnel-account hardening"
  local endmarker="# <<< xnet tunnel-account hardening"

  # Drop any previous block first so this is idempotent and the exclusion list
  # tracks a changed admin username instead of accumulating stale blocks.
  if grep -qF "$marker" "$cfg"; then
    sed -i "\|^${marker}\$|,\|^${endmarker}\$|d" "$cfg"
  fi

  # Build the exclusion list: root always, plus the panel's SSH admin when set.
  local excl="*,!root"
  local admin="${XNET_SSH_ADMIN_USER:-}"
  if [ -n "$admin" ] && [ "$admin" != "root" ]; then
    excl="${excl},!${admin}"
  fi

  # Match blocks must be LAST in sshd_config: every directive after a Match
  # belongs to it until the next Match or end of file. Appending guarantees we
  # never capture unrelated global directives into this block.
  {
    echo ""
    echo "$marker"
    echo "# Panel SSH accounts are tunnel-only: no interactive shell, no TTY."
    echo "# root and the panel SSH admin are excluded so the operator keeps shell access."
    echo "Match Group ssh-tcp-users User ${excl}"
    # ForceCommand runs INSTEAD of whatever the client asked for. The client's
    # command is exported as SSH_ORIGINAL_COMMAND and never executed, so
    # `ssh user@host <cmd>` cannot run anything. /bin/cat holds the session
    # channel open (tunnel apps that request a shell stay connected) while
    # doing nothing. direct-tcpip forwarding is a different channel type and is
    # unaffected — that is what keeps the tunnel working.
    echo "    ForceCommand /bin/cat"
    # No PTY: without this a client can still get an interactive terminal
    # allocated, and anything ForceCommand did not cover would run on it.
    echo "    PermitTTY no"
    # THE HOLE ForceCommand DOES NOT CLOSE: sshd executes ~/.ssh/rc with /bin/sh
    # on every login, before and independently of ForceCommand. A user whose
    # home directory is writable — which every panel account's is — could drop
    # arbitrary commands there and get them executed on each connection. This
    # is the directive that actually stops shell access, not ForceCommand.
    echo "    PermitUserRC no"
    echo "    X11Forwarding no"
    echo "    AllowAgentForwarding no"
    echo "$endmarker"
  } >> "$cfg"

  log "Hardening: panel SSH accounts on the main sshd are shell-free (excluded: root${admin:+, $admin})"

  # The secondary instances (WS / TLS / SlowDNS) serve ONLY panel tunnel
  # accounts — no administrator ever logs in through them — so they take the
  # same directives globally, with no Match block and no exclusions.
  #
  # They shipped with `ForceCommand /bin/cat` from the start, which is why those
  # ports never handed out a prompt. What they were missing is PermitUserRC:
  # ~/.ssh/rc is executed by sshd itself, so it bypassed ForceCommand entirely
  # and gave a user with a writable home a way to run commands on every connect.
  local scfg
  for scfg in /etc/ssh/sshd_config_ws /etc/ssh/sshd_config_tls /etc/ssh/sshd_config_dns; do
    [ -f "$scfg" ] || continue
    set_sshd_directive "$scfg" "ForceCommand" "/bin/cat"
    set_sshd_directive "$scfg" "PermitTTY" "no"
    set_sshd_directive "$scfg" "PermitUserRC" "no"
    set_sshd_directive "$scfg" "X11Forwarding" "no"
    set_sshd_directive "$scfg" "AllowAgentForwarding" "no"
    log "Hardening: $(basename "$scfg") is shell-free (ForceCommand + PermitTTY/PermitUserRC off)"
  done
}

# --- Helper: Update Port directive in sshd config (preserves AllowGroups) ----
update_sshd_port() {
  local config_file="$1" new_port="$2"
  [ -f "$config_file" ] || return 0
  if grep -q "^Port " "$config_file"; then
    sed -i "s/^Port [0-9]*/Port $new_port/" "$config_file"
  else
    sed -i "1i Port $new_port" "$config_file"
  fi
}

# --- Helper: set (or replace) a single sshd directive ------------------------
# Replaces the directive whether it is currently active or commented out, and
# appends it when absent. Case-insensitive, because sshd_config directives are.
# Never touches AllowGroups (see the file header contract).
# Uses a | delimiter in sed so values containing / (e.g. file paths) are safe.
set_sshd_directive() {
  local config_file="$1" directive="$2" value="$3"
  [ -f "$config_file" ] || return 0
  if grep -qiE "^[#[:space:]]*${directive}[[:space:]]" "$config_file"; then
    # Use | as sed delimiter — safe even when $value contains / characters.
    sed -i -E "s|^[#[:space:]]*${directive}[[:space:]].*|${directive} ${value}|I" "$config_file"
  else
    echo "${directive} ${value}" >> "$config_file"
  fi
}

# --- Banner: the admin's message + each account's stats block ----------------
#
# Everything the client sees is delivered PRE-AUTH, as the SSH banner. That is
# deliberate: the banner is the only thing every SSH client displays. Tunnel apps
# (HTTP Injector, NPV Tunnel, SocksIP) never open a session channel and never
# show session output, so a ForceCommand wrapper, /etc/ssh/sshrc or a profile.d
# script is invisible to them no matter how correctly it is wired — which is why
# earlier versions showed the admin's text but never the account details.
#
#   OpenSSH (tcp + ws + tls + dns):
#     Banner /etc/ssh/xnet-banner.txt                 <- global, plain text
#     Match User <acct> / Banner /etc/ssh/xnet-banners/<acct>.txt
#                                                     <- text + that account's block
#   Dropbear:
#     -b /etc/ssh/xnet-banner.txt                     <- text only; Dropbear has
#     /etc/profile.d/xnet-ssh-info.sh                    no per-user banner, so
#                                                        its block comes from the
#                                                        login shell hook
#
# sshd evaluates Match before sending the banner (the username arrives with the
# first userauth request), and it re-reads the banner file on every connection —
# so refreshing the numbers costs nothing and needs no reload. xnet-ssh-info
# --write-banners does the regeneration; a systemd timer keeps traffic current.
XNET_BANNER_FILE="/etc/ssh/xnet-banner.txt"
XNET_BANNER_DIR="/etc/ssh/xnet-banners"
XNET_PROFILE_SCRIPT="/etc/profile.d/xnet-ssh-info.sh"
XNET_USER_INFO_SCRIPT="/opt/xnet/xnet-ssh-info"
XNET_GREET_SCRIPT="/opt/xnet/xnet-ssh-greet"
XNET_SUDOERS_FILE="/etc/sudoers.d/xnet-ssh-info"
XNET_REFRESH_UNIT="/etc/systemd/system/xnet-ssh-banners.service"
XNET_REFRESH_TIMER="/etc/systemd/system/xnet-ssh-banners.timer"
# Hooks from earlier versions, removed on every apply (see remove_legacy_hooks).
XNET_SSHRC="/etc/ssh/sshrc"
XNET_SSHRC_MARK="xnet-managed-sshrc"
XNET_FC_SCRIPT="/opt/xnet/xnet-fc"
XNET_FC_PAM_SCRIPT="/opt/xnet/xnet-fc-pam"

apply_ssh_banner() {
  local banner_text
  banner_text="$(jget '.openssh.banner' '')"

  # Retire the session-hook mechanisms on every run, banner on or off, so an
  # upgraded server cannot end up printing the block twice (or running a hook
  # that never worked).
  remove_legacy_hooks

  # Trim leading/trailing blank lines so an accidental Enter before the first
  # word does not push the message down.
  banner_text="$(printf '%s' "$banner_text" | awk 'NF{found=1} found{print}' | awk '{lines[NR]=$0} END{for(i=NR;i>=1;i--){if(lines[i]~/[^[:space:]]/){last=i;break}} for(i=1;i<=last;i++){print lines[i]}}')"

  if [ -z "$banner_text" ] || [ "$banner_text" = "null" ]; then
    rm -f "$XNET_BANNER_FILE" 2>/dev/null || true
    local cfg
    for cfg in /etc/ssh/sshd_config /etc/ssh/sshd_config_ws /etc/ssh/sshd_config_tls /etc/ssh/sshd_config_dns; do
      [ -f "$cfg" ] || continue
      sed -i -E '\|^[#[:space:]]*Banner[[:space:]]|d' "$cfg"
    done
    # Drops the per-account files and the managed Match sections; it keys off the
    # now-missing banner file, so it must run after the rm above.
    regenerate_account_banners
    rm -f "$XNET_PROFILE_SCRIPT" "$XNET_SUDOERS_FILE" 2>/dev/null || true
    remove_refresh_timer
    log "Banner: disabled — text, per-account banners, hooks and sudoers rule removed"
    return 0
  fi

  printf '%s\n' "$banner_text" > "$XNET_BANNER_FILE"
  chmod 644 "$XNET_BANNER_FILE"

  install_user_info_scripts
  install_user_info_sudoers

  # Global Banner: what root and any non-account login sees. Per-account Match
  # blocks override it for the accounts themselves.
  local cfg
  for cfg in /etc/ssh/sshd_config /etc/ssh/sshd_config_ws /etc/ssh/sshd_config_tls /etc/ssh/sshd_config_dns; do
    [ -f "$cfg" ] || continue
    set_sshd_directive "$cfg" "Banner" "$XNET_BANNER_FILE"
  done
  log "Banner: written to $XNET_BANNER_FILE and set in all sshd configs"

  install_refresh_timer
  log "Banner + per-account stats configured"
}

# regenerate_account_banners rebuilds /etc/ssh/xnet-banners/* and the managed
# Match sections. It is also what the systemd timer calls.
#
# Called LAST in main() as well: the Match section has to sit at the very end of
# each sshd config, because every global directive after a Match belongs to that
# block. Any function that appends a directive must therefore run before this.
regenerate_account_banners() {
  ensure_sshd_unit_reload
  if [ ! -x "$XNET_USER_INFO_SCRIPT" ]; then
    log "warning: $XNET_USER_INFO_SCRIPT missing — per-account banners not generated"
    return 0
  fi
  # The helper reports which sshd configs received the Match section. Relay every
  # line: each config backs a different transport, so a config it could not
  # update means that protocol silently falls back to the plain banner text —
  # which is how the block ended up working on SSH TCP alone.
  local out rc
  out="$("$XNET_USER_INFO_SCRIPT" --write-banners 2>&1)"; rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | while IFS= read -r line; do log "$line"; done
  if [ "$rc" -ne 0 ]; then
    log "warning: some sshd configs did not receive the per-account banner section"
    HAD_ERROR=1
  fi
  local n=0
  [ -d "$XNET_BANNER_DIR" ] && n="$(find "$XNET_BANNER_DIR" -name '*.txt' 2>/dev/null | wc -l)"
  log "Per-account banners: ${n} account(s) in $XNET_BANNER_DIR"
}

# ensure_sshd_unit_reload adds ExecReload to the WS/TLS/SlowDNS sshd units when
# it is missing.
#
# Those units were generated without one, so `systemctl reload sshd-ws` fails
# with "Job type reload is not applicable" — and sshd only parses its config at
# startup, handing the parsed copy to each connection. The result: a Match block
# written into sshd_config_ws was never seen by the running daemon. The distro's
# own ssh unit does have ExecReload, which is exactly why the per-account banner
# worked on SSH TCP and on no other protocol.
#
# xnet-ssh-info also falls back to SIGHUP, so this is belt-and-braces — but it
# repairs the unit permanently instead of working around it on every run.
ensure_sshd_unit_reload() {
  local svc unit changed=0
  for svc in ws tls dns; do
    unit="/etc/systemd/system/sshd-${svc}.service"
    [ -f "$unit" ] || continue
    grep -q '^ExecReload=' "$unit" && continue
    # SIGHUP makes sshd re-exec and re-read its config while leaving established
    # sessions alone, so live tunnels are not dropped.
    sed -i '/^ExecStart=/a ExecReload=/bin/kill -HUP $MAINPID' "$unit"
    log "sshd-${svc}: added ExecReload (config changes could not reach it before)"
    changed=1
  done
  [ "$changed" = "1" ] && systemctl daemon-reload >/dev/null 2>&1
  return 0
}

# install_user_info_scripts installs the Dropbear-side login hook. The stats
# helper itself (/opt/xnet/xnet-ssh-info) ships with the panel and is installed
# by install.sh — this only checks that it is present and current, because a
# server that updated this helper alone would otherwise silently keep a copy
# that has no --write-banners mode.
install_user_info_scripts() {
  if [ ! -x "$XNET_USER_INFO_SCRIPT" ]; then
    log "ERROR: $XNET_USER_INFO_SCRIPT is missing — account stats cannot be generated."
    log "       Re-run install.sh (or copy install/xnet-ssh-info to /opt/xnet/) and retry."
    HAD_ERROR=1
    return 0
  fi
  if ! grep -q 'XNET_SSH_INFO_VERSION=2' "$XNET_USER_INFO_SCRIPT"; then
    log "ERROR: $XNET_USER_INFO_SCRIPT is OUTDATED (needs XNET_SSH_INFO_VERSION=2)."
    log "       Copy install/xnet-ssh-info to /opt/xnet/xnet-ssh-info and retry."
    HAD_ERROR=1
    return 0
  fi
  # Reachable through sudo from every SSH account, so it must stay root-owned.
  chown root:root "$XNET_USER_INFO_SCRIPT" 2>/dev/null || true
  chmod 755 "$XNET_USER_INFO_SCRIPT"

  # xnet-ssh-greet — the unprivileged wrapper the Dropbear hook calls.
  cat > "$XNET_GREET_SCRIPT" <<'SHEOF'
#!/bin/sh
# xnet-ssh-greet — print the current SSH account's stats block on stdout.
# Callers redirect to stderr; see /etc/profile.d/xnet-ssh-info.sh.
INFO=/opt/xnet/xnet-ssh-info

# Dropbear sets LOGNAME for every session; $USER is not set on all distros, and
# `id -un` is the last resort.
_u="${1:-}"
[ -n "$_u" ] || _u="${LOGNAME:-${USER:-$(id -un 2>/dev/null)}}"
[ -n "$_u" ] || exit 0
[ "$_u" = "root" ] && exit 0

if [ "$(id -u)" = "0" ]; then
  [ -x "$INFO" ] || exit 0
  "$INFO" "$_u" stdout 2>/dev/null
else
  # Deliberately NOT gated on an -x test here: that test would run as the SSH
  # account, which may not be able to stat /opt/xnet at all, and failing it would
  # skip the sudo call that would have succeeded. Let sudo be the one to decide.
  #
  # Needs /etc/sudoers.d/xnet-ssh-info. sudo's own diagnostics are dropped so a
  # misconfiguration cannot corrupt a tunnel's stream; the reason goes to syslog.
  sudo -n "$INFO" "$_u" stdout 2>/dev/null || {
    command -v logger >/dev/null 2>&1 && logger -t xnet-ssh-greet -p authpriv.warning \
      "sudo -n $INFO failed for $_u — check /etc/sudoers.d/xnet-ssh-info"
  }
fi
exit 0
SHEOF
  chown root:root "$XNET_GREET_SCRIPT" 2>/dev/null || true
  chmod 755 "$XNET_GREET_SCRIPT"

  # profile.d — Dropbear's stats hook. OpenSSH does not need one: its accounts
  # get the block in the banner itself.
  cat > "$XNET_PROFILE_SCRIPT" <<'SHEOF'
# xnet-ssh-info.sh — X-Net panel: per-account stats block on Dropbear logins.
#
# This file is SOURCED by /etc/profile, so it must never call `exit` — that
# would terminate the user's login shell. (It previously ran `exit 0` when
# SSH_CONNECTION was unset, which killed every console login and `su -`.)
#
# OpenSSH accounts receive their block in the pre-auth banner, so this hook is
# scoped to Dropbear by checking which daemon started the shell. Without that
# check an OpenSSH login would print the block twice.
if [ -n "$SSH_CONNECTION" ] && [ -x /opt/xnet/xnet-ssh-greet ]; then
	_xnet_parent=""
	[ -r "/proc/$PPID/comm" ] && _xnet_parent="$(cat "/proc/$PPID/comm" 2>/dev/null)"
	case "$_xnet_parent" in
		dropbear*) /opt/xnet/xnet-ssh-greet >&2 ;;
	esac
	unset _xnet_parent
fi
SHEOF
  chmod 644 "$XNET_PROFILE_SCRIPT"

  harden_user_info_paths
  log "User-info scripts installed: xnet-ssh-greet, profile.d (Dropbear hook)"
}

# harden_user_info_paths makes the helpers reachable by an SSH account while
# keeping the panel's data out of reach.
#
# The Dropbear hook runs as the logging-in user, so /opt/xnet has to be
# traversable or even `[ -x /opt/xnet/xnet-ssh-greet ]` fails and the session
# silently prints nothing. Nothing in the installer ever set that mode — it
# inherited root's umask, so on a hardened host it can be 0750 and the hook dies
# quietly. Making the directory traversable would expose /opt/xnet/data/xnet.db,
# which sqlite creates 0644 and which holds admin password hashes and every
# client's UUID, so the data directory is locked down in the same pass.
harden_user_info_paths() {
  chmod o+rx /opt/xnet 2>/dev/null || true
  if [ -d /opt/xnet/data ]; then
    chmod 0750 /opt/xnet/data 2>/dev/null || true
    find /opt/xnet/data -maxdepth 1 -type f -name 'xnet.db*' -exec chmod 0640 {} + 2>/dev/null || true
  fi
  # The .env holds the JWT secret and node keys — never group- or world-readable.
  [ -f /opt/xnet/.env ] && chmod 0600 /opt/xnet/.env 2>/dev/null || true
  return 0
}

# install_user_info_sudoers lets the Dropbear hook read the panel DB. OpenSSH no
# longer needs it (sshd reads the banner file itself, as root), but Dropbear's
# hook runs as the account and has no other way in.
install_user_info_sudoers() {
  local tmp="/etc/sudoers.d/.xnet-ssh-info.tmp"   # dotted name => ignored by sudo while staging
  cat > "$tmp" <<'EOF'
# ---- X-Net Panel — SSH account stats ----
# /etc/profile.d/xnet-ssh-info.sh runs as the logging-in user on Dropbear
# sessions and needs this to read the panel DB. xnet-ssh-info is read-only in
# this mode: it prints the ssh_accounts row for the username it is handed.
Defaults!/opt/xnet/xnet-ssh-info !requiretty
ALL ALL=(root) NOPASSWD: /opt/xnet/xnet-ssh-info, /opt/xnet/xnet-ssh-info *
EOF
  chmod 0440 "$tmp"
  # Validate before activating: an invalid file in /etc/sudoers.d breaks sudo for
  # every user, including the panel's own privileged helpers.
  if ! command -v visudo >/dev/null 2>&1 || visudo -cf "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$XNET_SUDOERS_FILE"
    log "sudoers: $XNET_SUDOERS_FILE installed"
  else
    rm -f "$tmp" 2>/dev/null || true
    log "sudoers: WARNING — validation failed, Dropbear stats will not be shown"
  fi
}

# install_refresh_timer keeps the numbers in each account's banner current.
# Content refreshes never touch sshd_config and never reload anything, so this
# can run often; only adding or removing an account rewrites the Match sections.
install_refresh_timer() {
  cat > "$XNET_REFRESH_UNIT" <<'UNIT'
[Unit]
Description=X-Net: refresh per-account SSH banners
[Service]
Type=oneshot
ExecStart=/opt/xnet/xnet-ssh-info --write-banners
UNIT
  cat > "$XNET_REFRESH_TIMER" <<'UNIT'
[Unit]
Description=X-Net: refresh per-account SSH banners every 2 minutes
[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=15s
[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now xnet-ssh-banners.timer >/dev/null 2>&1 \
    && log "Refresh timer: xnet-ssh-banners.timer enabled (every 2 min)" \
    || log "warning: could not enable xnet-ssh-banners.timer — traffic figures will only update on apply"
}

remove_refresh_timer() {
  systemctl disable --now xnet-ssh-banners.timer >/dev/null 2>&1 || true
  rm -f "$XNET_REFRESH_UNIT" "$XNET_REFRESH_TIMER" 2>/dev/null || true
  systemctl daemon-reload >/dev/null 2>&1 || true
}

# remove_legacy_hooks retires every earlier stats mechanism: the xnet-fc
# ForceCommand wrapper, the Dropbear pam_exec hook, and the /etc/ssh/sshrc hook.
# All are removed unconditionally so an upgraded server never runs two at once.
remove_legacy_hooks() {
  local cfg
  # Restore the plain /bin/cat these instances are configured with. Deleting the
  # line outright would leave them with no ForceCommand at all, handing
  # tunnel-only accounts a real shell.
  for cfg in /etc/ssh/sshd_config_ws /etc/ssh/sshd_config_tls /etc/ssh/sshd_config_dns; do
    [ -f "$cfg" ] || continue
    grep -qF "xnet-fc" "$cfg" || continue
    set_sshd_directive "$cfg" "ForceCommand" "/bin/cat"
    log "ForceCommand: restored /bin/cat in $cfg (was xnet-fc)"
  done
  if [ -f /etc/pam.d/dropbear ] && grep -qF "xnet-fc-pam" /etc/pam.d/dropbear; then
    sed -i '/xnet-fc-pam/d' /etc/pam.d/dropbear
    log "Dropbear PAM: removed the xnet-fc-pam hook (pam_exec discarded its output)"
  fi
  rm -f "$XNET_FC_SCRIPT" "$XNET_FC_PAM_SCRIPT" 2>/dev/null || true
  # sshrc reached OpenSSH session channels, which tunnel apps never display.
  # Superseded by the per-account banner; leaving it would double-print for
  # anyone using a terminal client.
  if [ -f "$XNET_SSHRC" ]; then
    if grep -qF "$XNET_SSHRC_MARK" "$XNET_SSHRC"; then
      rm -f "$XNET_SSHRC"
      log "sshrc: removed $XNET_SSHRC (superseded by per-account banners)"
    elif grep -qF "xnet-ssh-greet" "$XNET_SSHRC"; then
      sed -i '/xnet-ssh-greet/d;/# xnet: per-account stats on login/d' "$XNET_SSHRC"
      log "sshrc: removed the xnet hook from the existing $XNET_SSHRC"
    fi
  fi
}
# --- Keepalive: reap sessions whose client vanished --------------------------
# Without this, a client that disappears without a clean disconnect (mobile
# network drop, app force-closed) leaves a half-open connection: the daemon
# never notices, the per-session process stays alive, and the account keeps
# showing as online — permanently consuming one of its max_login slots.
#
# ClientAliveInterval makes sshd probe the peer; after ClientAliveCountMax
# unanswered probes the session is dropped. It does NOT disconnect a live but
# idle tunnel (the peer answers the probe), which is why this is safe for VPN
# use where ClientAliveCountMax*Interval of true silence means the peer is gone.
#
# Applied to the main sshd AND to the three internal instances that back the
# WS / TLS / SlowDNS transports — those carry the same defect, so fixing only
# the main config would leave four of the six protocols still leaking sessions.
apply_ssh_keepalive() {
  local interval count
  interval="$(jget '.openssh.keepAlive' '60')"
  # 0 or a non-numeric value means "disabled": clear the probes rather than
  # writing a broken directive that would stop sshd from starting.
  [[ "$interval" =~ ^[0-9]+$ ]] || interval=60
  count=3
  if [ "$interval" -le 0 ]; then
    interval=0
    count=0
  fi

  local cfg
  for cfg in /etc/ssh/sshd_config /etc/ssh/sshd_config_ws /etc/ssh/sshd_config_tls /etc/ssh/sshd_config_dns; do
    [ -f "$cfg" ] || continue
    set_sshd_directive "$cfg" "ClientAliveInterval" "$interval"
    set_sshd_directive "$cfg" "ClientAliveCountMax" "$count"
  done
  log "Keepalive: ClientAliveInterval=${interval} ClientAliveCountMax=${count} (main + ws/tls/dns sshd)"
}

# dropbear_keepalive_flag echoes the "-K <secs>" argument for Dropbear, or an
# empty string when keepalive is disabled. Dropbear's default is 0 (off), which
# is why dead Dropbear sessions previously lingered indefinitely.
dropbear_keepalive_flag() {
  local interval
  interval="$(jget '.openssh.keepAlive' '60')"
  [[ "$interval" =~ ^[0-9]+$ ]] || interval=60
  [ "$interval" -gt 0 ] && echo "-K ${interval}"
}

# --- OpenSSH (main sshd on port 22) -----------------------------------------
apply_openssh() {
  local enabled port maxs
  enabled="$(jget '.openssh.enabled' 'true')"
  port="$(jget '.openssh.port' '22')"
  maxs="$(jget '.openssh.maxSessions' '10')"
  [ -f /etc/ssh/sshd_config ] || return 0

  if [[ "$port" =~ ^[0-9]+$ ]]; then
    update_sshd_port /etc/ssh/sshd_config "$port"
  fi

  # Modern Ubuntu/Debian default to SSH socket activation (ssh.socket). The
  # listening port is then controlled by the socket's ListenStream and the
  # `Port` directive in sshd_config is ignored. Running BOTH ssh.socket and a
  # standalone ssh.service that bind the same port causes systemd to flap (the
  # daemon is repeatedly stopped/started), which surfaces to clients as
  # "kex_exchange_identification: Connection reset" — i.e. you cannot log in on
  # the new port even though everything looks configured.
  #
  # To make a custom port reliable we standardize on EXACTLY ONE mechanism:
  # disable socket activation and let the classic ssh.service bind the Port from
  # sshd_config (which we set above). This is the documented, stable way to run
  # sshd on a custom port on socket-activated distros.
  if [[ "$port" =~ ^[0-9]+$ ]]; then
    local sock=""
    if systemctl cat ssh.socket >/dev/null 2>&1; then sock="ssh.socket"
    elif systemctl cat sshd.socket >/dev/null 2>&1; then sock="sshd.socket"; fi
    if [ -n "$sock" ]; then
      # Remove any stale xnet ListenStream drop-in written by older versions.
      rm -f "/etc/systemd/system/${sock}.d/xnet-port.conf" 2>/dev/null || true
      rmdir "/etc/systemd/system/${sock}.d" 2>/dev/null || true
      # Stop + disable socket activation so the port is freed for ssh.service and
      # the two mechanisms can no longer fight over it.
      systemctl disable --now "$sock" >/dev/null 2>&1 || true
      systemctl daemon-reload 2>/dev/null || true
      log "OpenSSH: disabled ${sock} (socket activation) — using classic ssh.service on port ${port}"
    fi
  fi
  if [[ "$maxs" =~ ^[0-9]+$ ]] && [ "$maxs" -gt 0 ]; then
    if grep -qiE '^[#[:space:]]*MaxSessions[[:space:]]' /etc/ssh/sshd_config; then
      sed -i -E "s/^[#[:space:]]*MaxSessions[[:space:]].*/MaxSessions ${maxs}/I" /etc/ssh/sshd_config
    else
      echo "MaxSessions ${maxs}" >> /etc/ssh/sshd_config
    fi
  fi
  grep -qiE '^[[:space:]]*AllowTcpForwarding[[:space:]]+yes' /etc/ssh/sshd_config || echo "AllowTcpForwarding yes" >> /etc/ssh/sshd_config

  # ANTI-LOCKOUT: before (re)starting sshd on the new port, make sure the admin
  # is still permitted by AllowGroups and that the new port is reachable through
  # any active firewall. Without these, a port change can lock the operator out.
  ensure_login_group_membership
  # Runs AFTER the anti-lockout so the exclusion list is applied on top of the
  # membership it just guaranteed, and BEFORE the restart so both land together.
  harden_tunnel_accounts
  if [ "$enabled" = "true" ] && [[ "$port" =~ ^[0-9]+$ ]]; then
    open_fw_port "$port"
  fi

  local unit="ssh"
  systemctl list-unit-files ssh.service 2>/dev/null | grep -q ssh.service || unit="sshd"
  if [ "$enabled" = "true" ]; then restart_unit "$unit"; fi
  log "OpenSSH: port=${port} maxSessions=${maxs}"
}

# --- WebSocket sshd (sshd_config_ws) -----------------------------------------
apply_ws_sshd() {
  local enabled port
  enabled="$(jget '.websocket.enabled' 'false')"
  port="$(jget '.websocket.port' '2222')"
  [[ "$port" =~ ^[0-9]+$ ]] || port=2222

  # IMPORTANT: Do NOT change the internal sshd-ws port. It is always 2222 
  # (127.0.0.1 only). The panel's in-process WS proxy handles the public port.
  # Only enable/disable the unit.

  if [ "$enabled" = "true" ]; then
    # The WS sshd unit is named sshd-ws on a standard install (see
    # xnet-install-sshd.sh). Older/alternate deployments may use xnet-ws.
    # If neither unit is installed, the WebSocket path is served by the
    # panel-managed in-process proxy and there is nothing to restart — that is
    # NOT an error, so do not flag HAD_ERROR.
    if ! restart_first_existing sshd-ws xnet-ws; then
      log "WebSocket sshd: no sshd-ws/xnet-ws unit installed (panel-managed WS proxy) — skipping service restart"
    fi
  else
    unit_exists sshd-ws && stop_unit sshd-ws
    unit_exists xnet-ws && stop_unit xnet-ws
  fi

  # Open firewall for the WS listener port (panel-managed WebSocket proxy)
  local ws_listen_port
  ws_listen_port="$(jget '.websocket.listenPort' '8880')"
  if [ "$enabled" = "true" ] && [[ "$ws_listen_port" =~ ^[0-9]+$ ]]; then
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
      ufw allow "${ws_listen_port}/tcp" >/dev/null 2>&1 || true
    elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
      firewall-cmd --permanent --add-port="${ws_listen_port}/tcp" >/dev/null 2>&1 || true
      firewall-cmd --reload >/dev/null 2>&1 || true
    fi
  fi
  log "WebSocket sshd: port=${port} enabled=${enabled}"
}

# --- TLS sshd (sshd_config_tls) + stunnel ------------------------------------
apply_tls() {
  local enabled port cert key
  enabled="$(jget '.tlsSsl.enabled' 'false')"
  port="$(jget '.tlsSsl.port' '2083')"
  cert="$(jget '.tlsSsl.certPath' '')"
  key="$(jget '.tlsSsl.keyPath' '')"
  local ws_tls_port
  ws_tls_port="$(jget '.tlsSsl.wsTlsPort' '2084')"

  # sshd_tls internal port (stunnel connects to this for direct SSH-TLS)
  local sshd_tls_port="2223"
  [[ "$port" =~ ^[0-9]+$ ]] || port=2083
  [[ "$ws_tls_port" =~ ^[0-9]+$ ]] || ws_tls_port=2084

  # Heal legacy installs: older installers shipped /etc/stunnel/xnet-ssh.conf
  # with a hardcoded `connect = 127.0.0.1:22`. stunnel loads every *.conf in
  # /etc/stunnel, so that stale file keeps dialing the main sshd and breaks the
  # moment the OpenSSH port changes. We forward TLS only to the dedicated
  # sshd_tls (127.0.0.1:2223) via stunnel.conf, so remove the legacy file.
  rm -f /etc/stunnel/xnet-ssh.conf 2>/dev/null || true

  # IMPORTANT: Do NOT change sshd-tls internal port (2223). stunnel handles
  # the public port and forwards to 127.0.0.1:2223.

  if [ "$enabled" != "true" ]; then
    stop_unit stunnel4
    stop_unit sshd-tls 2>/dev/null || true
    log "TLS/stunnel: disabled"
    return 0
  fi

  # Restart sshd-tls
  unit_exists sshd-tls && restart_unit sshd-tls

  # Configure stunnel with two sections:
  # 1. ssh-tls-direct: accepts on TLS port, forwards raw SSH to sshd_tls
  # 2. ssh-tls-payload: accepts on WS-TLS port, forwards HTTP payload to WSProxy
  mkdir -p /etc/stunnel
  if [ -z "$cert" ] || [ -z "$key" ] || [ ! -f "$cert" ] || [ ! -f "$key" ]; then
    cert=/etc/stunnel/xnet-self.crt
    key=/etc/stunnel/xnet-self.key
    if [ ! -f "$cert" ] || [ ! -f "$key" ]; then
      openssl req -x509 -newkey rsa:2048 -keyout "$key" -out "$cert" -days 3650 -nodes \
        -subj "/CN=xnet" >/dev/null 2>&1 || true
    fi
  fi

  # Determine WSProxy port (where HTTP-payload TLS traffic goes)
  local ws_proxy_port
  ws_proxy_port="$(jget '.websocket.port' '80')"

  cat > /etc/stunnel/stunnel.conf <<CONF
pid = /var/run/stunnel4.pid

[ssh-tls-direct]
accept = ${port}
connect = 127.0.0.1:${sshd_tls_port}
cert = ${cert}
key = ${key}

[ssh-tls-payload]
accept = ${ws_tls_port}
connect = 127.0.0.1:${ws_proxy_port}
cert = ${cert}
key = ${key}
CONF
  [ -f /etc/default/stunnel4 ] && sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/stunnel4 2>/dev/null || true
  restart_unit stunnel4
  log "TLS/stunnel: direct_port=${port}->sshd_tls:${sshd_tls_port}, ws_tls_port=${ws_tls_port}->ws_proxy:${ws_proxy_port}"
}

# --- SlowDNS sshd (sshd_config_dns) + slowdns service ------------------------
apply_slowdns() {
  local enabled port ns key bin
  enabled="$(jget '.slowdns.enabled' 'false')"
  port="$(jget '.slowdns.port' '2224')"
  ns="$(jget '.slowdns.nsDomain' '')"
  key="$(jget '.slowdns.privateKey' '')"
  local dns_port
  dns_port="$(jget '.slowdns.dnsPort' '5300')"

  # Update sshd_config_dns Port
  [[ "$port" =~ ^[0-9]+$ ]] || port=2224
  if [ -f /etc/ssh/sshd_config_dns ]; then
    update_sshd_port /etc/ssh/sshd_config_dns "$port"
  fi

  if [ "$enabled" != "true" ]; then
    stop_unit slowdns
    stop_unit sshd-dns 2>/dev/null || true
    log "SlowDNS: disabled"
    return 0
  fi

  # Restart sshd-dns
  unit_exists sshd-dns && restart_unit sshd-dns

  bin="$(command -v dns-server || command -v sldns-server || echo /usr/local/bin/dns-server)"
  if [ ! -x "$bin" ]; then
    if [ "$(uname -m)" = "x86_64" ]; then
      log "SlowDNS: fetching prebuilt server binary..."
      curl -fsSL "https://raw.githubusercontent.com/khaledagn/DNS-AGN/main/files/dns-server" -o /usr/local/bin/dns-server 2>/dev/null \
        && chmod +x /usr/local/bin/dns-server && bin=/usr/local/bin/dns-server
    fi
  fi
  if [ ! -x "$bin" ] || [ -z "$ns" ]; then
    log "SlowDNS: server binary or nsDomain missing — service not started"
    return 0
  fi
  mkdir -p /etc/slowdns
  [ -n "$key" ] && printf '%s' "$key" > /etc/slowdns/server.key
  cat > /etc/systemd/system/slowdns.service <<UNIT
[Unit]
Description=SlowDNS server (xnet-managed)
After=network.target
[Service]
ExecStart=${bin} -udp :${dns_port} -privkey-file /etc/slowdns/server.key ${ns} 127.0.0.1:${port}
Restart=on-failure
[Install]
WantedBy=multi-user.target
UNIT
  pkill -f dns-server >/dev/null 2>&1 || true
  sleep 0.3
  restart_unit slowdns
  log "SlowDNS: dns_port=${dns_port} sshd_port=${port} ns=${ns}"
}

# --- Dropbear ----------------------------------------------------------------
apply_dropbear() {
  local enabled port
  enabled="$(jget '.dropbear.enabled' 'false')"
  port="$(jget '.dropbear.port' '444')"
  if [ "$enabled" != "true" ]; then stop_unit dropbear; log "Dropbear: disabled"; return 0; fi
  [[ "$port" =~ ^[0-9]+$ ]] || port=444

  if [ -d /etc/default ]; then
    {
      echo "NO_START=0"
      echo "DROPBEAR_PORT=${port}"
      echo "DROPBEAR_EXTRA_ARGS="
    } > /etc/default/dropbear
  fi

  # Always ensure the systemd unit file has the correct port in ExecStart.
  # This is critical: many systems ignore /etc/default/dropbear and only use
  # the -p flag in the ExecStart line of the service file.
  local bin; bin="$(command -v dropbear || echo /usr/sbin/dropbear)"
  local ka; ka="$(dropbear_keepalive_flag)"
  # Banner flag: -b <file> when a banner file exists
  local banner_flag=""
  [ -f "$XNET_BANNER_FILE" ] && banner_flag="-b ${XNET_BANNER_FILE}"
  # -c: forced command. Dropbear has no ForceCommand directive and no config
  # file to put one in, so this flag is the only way to stop a tunnel account
  # from getting an interactive shell on the Dropbear port. Without it any
  # panel SSH account could `ssh` in and land on a real prompt.
  #
  # /bin/cat mirrors what the WS/TLS/SlowDNS sshd instances already force: it
  # holds the session channel open (so clients that ask for a shell are not
  # disconnected) while executing nothing. Port forwarding is unaffected —
  # a forced command replaces the SESSION channel only, never direct-tcpip.
  #
  # Applying it to the whole daemon is safe here because Dropbear is a
  # tunnel-only port: the administrator's shell access is the main sshd, which
  # keeps its interactive shell (see harden_tunnel_accounts).
  #
  # Probed rather than assumed: dropbear rejects unknown flags and exits, so
  # hardcoding -c on a build that lacks it would leave the unit in a restart
  # loop and take the Dropbear port down completely. `dropbear -h` prints its
  # usage to stderr and exits non-zero, hence the redirect and the `|| true`.
  local forced_cmd=""
  if "$bin" -h 2>&1 | grep -qE '^[[:space:]]*-c[[:space:]]'; then
    forced_cmd="-c /bin/cat"
  else
    log "WARNING: this dropbear build has no -c (forced command) flag — accounts on the Dropbear port can obtain a shell. Consider disabling Dropbear in the panel."
  fi
  cat > /etc/systemd/system/dropbear.service <<UNIT
[Unit]
Description=Dropbear SSH server (xnet-managed)
After=network.target
[Service]
ExecStart=${bin} -F -E -p ${port} ${ka} ${banner_flag} ${forced_cmd}
Restart=on-failure
[Install]
WantedBy=multi-user.target
UNIT
  # Remove any stale override that might conflict
  rm -f /etc/systemd/system/dropbear.service.d/port-override.conf 2>/dev/null || true
  rmdir /etc/systemd/system/dropbear.service.d 2>/dev/null || true

  open_fw_port "$port"
  restart_unit dropbear
  log "Dropbear: port=${port}"
}

# --- BadVPN UDPGW ------------------------------------------------------------
apply_udpgw() {
  local enabled port bin
  enabled="$(jget '.udpgw.enabled' 'false')"
  port="$(jget '.udpgw.port' '7300')"
  if [ "$enabled" != "true" ]; then stop_unit badvpn-udpgw; log "UDPGW: disabled"; return 0; fi
  [[ "$port" =~ ^[0-9]+$ ]] || port=7300
  bin="$(command -v badvpn-udpgw || echo /usr/bin/badvpn-udpgw)"
  [ -x "$bin" ] || { log "UDPGW: badvpn-udpgw binary not found — skipping"; return 0; }
  cat > /etc/systemd/system/badvpn-udpgw.service <<UNIT
[Unit]
Description=BadVPN UDPGW for SSH UDP forwarding (xnet-managed)
After=network.target
[Service]
ExecStart=${bin} --listen-addr 127.0.0.1:${port} --max-clients 512 --max-connections-for-client 10
Restart=on-failure
[Install]
WantedBy=multi-user.target
UNIT
  pkill -f badvpn-udpgw >/dev/null 2>&1 || true
  sleep 0.3
  restart_unit badvpn-udpgw
  log "UDPGW: port=${port}"
}

# --- Main --------------------------------------------------------------------
main() {
  # FIRST: keepalive and banner both touch every sshd config file. They must
  # run before the per-transport functions below, because those are what restart
  # the units — writing the directives afterwards would leave them unapplied
  # until the next unrelated restart.
  apply_ssh_keepalive
  apply_ssh_banner
  apply_openssh
  apply_ws_sshd
  apply_tls
  apply_slowdns
  apply_dropbear
  apply_udpgw
  # LAST, and it must stay last. The per-account `Match User` blocks live at the
  # end of each sshd config, and every global directive that follows a Match
  # belongs to that block — so anything above that appends a directive has to run
  # first. Regenerating here strips and re-appends the section, which also lifts
  # it back to the end if an earlier step appended something after it.
  regenerate_account_banners
  log "apply complete"
}

main

if [ "$HAD_ERROR" -ne 0 ]; then
  exit 2
fi
exit 0
